# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared
.next
.turbo
.svelte-kit
.nuxt
.output
.vercel

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Environment secrets (keep safe example files trackable)
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
.envrc

# Replit Agent metadata that can contain internal asset references
/.agents/agent_assets_metadata.toml

# Private keys and private-key certificate bundles
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Local database files and exported backups (keep SQL migrations trackable)
*.sqlite
*.sqlite3
*.db
*.dump
*.sql
*.sql.gz
*.bak
*.backup
!**/migrations/*.sql
!**/migrations/**/*.sql
!**/schema.sql

# Local credential files
/secrets.json
/credentials.json
**/secrets.local.*
**/credentials.local.*
/.aws/credentials
/.config/gcloud/application_default_credentials.json
